<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.shinoaki.wowsreplay</groupId>
        <artifactId>wows-replay-wg</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>wows-replay-wg-dumper</artifactId>
    <name>wows-replay-wg-dumper</name>
    <description>Replay dumper: minimap timeline extraction and JSON output (replay-dumper-minimap.md)</description>

    <dependencies>
        <dependency>
            <groupId>com.shinoaki.wowsreplay</groupId>
            <artifactId>wows-replay-wg-ingest</artifactId>
        </dependency>
        <dependency>
            <groupId>com.shinoaki.wowsreplay</groupId>
            <artifactId>wows-replay-wg-merge</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.2</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <shadedArtifactAttached>true</shadedArtifactAttached>
                            <shadedClassifierName>all</shadedClassifierName>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>com.shinoaki.wowsreplay.dumper.DumperMain</mainClass>
                                </transformer>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>module-info.class</exclude>
                                        <!-- 新增：排除 BC 未签名的文件 -->
                                        <exclude>META-INF/LICENSE.md</exclude>
                                        <exclude>META-INF/NOTICE.md</exclude>
                                    </excludes>
                                </filter>
                                <filter>
                                    <!-- 明确指定 BC 的 groupId 和 artifactId -->
                                    <artifact>org.bouncycastle:bcprov-jdk18on</artifact>
                                    <excludes>
                                        <exclude>META-INF/LICENSE.md</exclude>
                                        <exclude>META-INF/NOTICE.md</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
