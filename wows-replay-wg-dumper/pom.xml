<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.wows</groupId>
        <artifactId>wows-replay-wg</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>wows-replay-wg-dumper</artifactId>
    <name>wows-replay-wg-dumper</name>
    <description>Replay dumper: minimap timeline extraction and JSON output (replay-dumper-minimap.md)</description>

    <dependencies>
        <dependency>
            <groupId>com.wows</groupId>
            <artifactId>wows-replay-wg-ingest</artifactId>
        </dependency>
        <dependency>
            <groupId>com.wows</groupId>
            <artifactId>wows-replay-wg-merge</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                产出自包含 fat jar（classifier=all，含全部依赖 + 原生库），供外部非 Maven 项目
                单文件依赖（java -jar 可直接运行 DumperMain）。普通 jar 仍走 Maven 坐标消费：
                com.wows:wows-replay-wg-dumper（依赖 core/ingest/merge 经 mvn install 装到本地库）。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.3</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <shadedArtifactAttached>true</shadedArtifactAttached>
                            <shadedClassifierName>all</shadedClassifierName>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>com.wows.replay.dumper.DumperMain</mainClass>
                                </transformer>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
